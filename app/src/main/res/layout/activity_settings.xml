<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/keynova_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/home_hero_bg"
            android:padding="22dp">

            <ImageButton
                android:id="@+id/btnSettingsTop"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="top|start"
                android:background="@drawable/home_icon_bg"
                android:contentDescription="@string/menu_settings"
                android:padding="9dp"
                android:src="@drawable/ic_settings_gear"
                android:tint="@color/keynova_accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="52dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_welcome"
                    android:textColor="@color/keynova_text"
                    android:textSize="32sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/keynova_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/keynova_key_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/statusEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/keynova_status_warn"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/keynova_status_warn"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="شروع سریع"
            android:textColor="@color/keynova_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardEnable"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/home_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/home_icon_bg" android:padding="8dp" android:src="@drawable/ic_home_enable" android:tint="@color/keynova_accent" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/menu_enable" android:textColor="@color/keynova_text" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardSelect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/home_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/home_icon_bg" android:padding="8dp" android:src="@drawable/ic_home_select" android:tint="@color/keynova_accent" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/menu_select" android:textColor="@color/keynova_text" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTest"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/home_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">
                <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/home_icon_bg" android:padding="8dp" android:src="@drawable/ic_home_test" android:tint="@color/keynova_accent" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/menu_test" android:textColor="@color/keynova_text" android:textSize="13sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <EditText
            android:id="@+id/testInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/keynova_key_bg"
            android:hint="@string/test_keyboard_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="12dp"
            android:textColor="@color/keynova_text"
            android:textColorHint="@color/keynova_text_secondary"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
