<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/keynova_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/home_hero_bg"
            android:padding="22dp">

            <ImageButton
                android:id="@+id/btnSettingsTop"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="top|start"
                android:background="@drawable/home_icon_bg"
                android:contentDescription="@string/menu_settings"
                android:padding="9dp"
                android:src="@drawable/ic_settings_gear"
                android:tint="@color/keynova_accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="52dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_welcome"
                    android:textColor="@color/keynova_text"
                    android:textSize="32sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/keynova_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@color/keynova_key_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/statusEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/keynova_status_warn"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/keynova_status_warn"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/group_typing"
            android:textColor="@color/keynova_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout android:id="@+id/cardEnable" style="@style/HomeCard">
            <ImageView style="@style/HomeCardIcon" android:src="@drawable/ic_home_enable" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/HomeCardTitle" android:text="@string/menu_enable" />
                <TextView style="@style/HomeCardDesc" android:text="@string/enable_keyboard_desc" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/cardSelect" style="@style/HomeCard">
            <ImageView style="@style/HomeCardIcon" android:src="@drawable/ic_home_select" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/HomeCardTitle" android:text="@string/menu_select" />
                <TextView style="@style/HomeCardDesc" android:text="@string/select_keyboard_desc" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/cardTest" style="@style/HomeCard">
            <ImageView style="@style/HomeCardIcon" android:src="@drawable/ic_home_test" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView style="@style/HomeCardTitle" android:text="@string/menu_test" />
                <TextView style="@style/HomeCardDesc" android:text="@string/test_keyboard_desc" />
            </LinearLayout>
        </LinearLayout>

        <EditText
            android:id="@+id/testInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@color/keynova_key_bg"
            android:hint="@string/test_keyboard_hint"
            android:inputType="textMultiLine"
            android:minLines="3"
            android:padding="12dp"
            android:textColor="@color/keynova_text"
            android:textColorHint="@color/keynova_text_secondary"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
