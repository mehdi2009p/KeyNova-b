<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.KeyNova" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/keynova_accent</item>
        <item name="colorPrimaryVariant">@color/keynova_accent_pressed</item>
        <item name="colorOnPrimary">@color/keynova_text</item>
        <item name="colorSecondary">@color/keynova_accent</item>
        <item name="android:statusBarColor">@color/keynova_background</item>
        <item name="android:navigationBarColor">@color/keynova_background</item>
        <item name="android:windowBackground">@color/keynova_background</item>
    </style>

    <style name="SettingsGroupTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/keynova_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/keynova_key_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">14dp</item>
    </style>

    <style name="SettingsSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/keynova_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/keynova_text</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsDesc">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@color/keynova_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/keynova_accent</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsSeek">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:progressTint">@color/keynova_accent</item>
        <item name="android:thumbTint">@color/keynova_accent</item>
    </style>

    <style name="SettingsDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:background">#3A3D42</item>
    </style>

    <style name="HomeCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/home_card_bg</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="HomeCardIcon">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/home_icon_bg</item>
        <item name="android:padding">10dp</item>
        <item name="android:tint">@color/keynova_accent</item>
    </style>

    <style name="HomeCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/keynova_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="HomeCardDesc">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textColor">@color/keynova_text_secondary</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
